t0 = time()
s = 0
for i = 1 to 20000: s = s + i: next
t1 = time()
print "boucle entiere : "; t1 - t0
c = 0
for i = 1 to 5000: if i % 7 = 3 then c = c + 1
next
t2 = time()
print "modulo/compare : "; t2 - t1
x = 0
for i = 1 to 3000: x = x + i * 3 \ 2: next
t3 = time()
