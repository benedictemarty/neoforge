r = 0
call fact(5)
print "5! = "; r
call fib(10)
print "fib(10) = "; r
call hanoi(3, 1, 3, 2)
print
end
proc fact(n)
  local m
  m = n
  if n <= 1
    r = 1
  else
    call fact(n - 1)
    r = r * m
  endif
endproc
proc fib(n)
  local a, b
  if n < 2
    r = n
  else
    call fib(n - 1): a = r
    call fib(n - 2): b = r
    r = a + b
  endif
endproc
proc hanoi(n, de, vers, via)
  local k, d, v, w
  k = n: d = de: v = vers: w = via
  if k > 0
    call hanoi(k - 1, d, w, v)
    print d; ">"; v; " ";
    call hanoi(k - 1, w, v, d)
  endif
endproc
