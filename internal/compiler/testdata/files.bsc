open output 4, "test.dat"
print #4, 42, "Hello", 2.5, -7
close 4
open input 5, "test.dat"
input #5, n, t$, f, m
print n; t$; f; m; eof(5)
close 5
dim v(2)
open input 5, "test.dat"
input #5, v(1)
print v(1); eof(5)
close
save "mem.dat", $7000, 4
print exists("test.dat"); exists("absent.dat")
print "fin"
open output 2, "lines.txt"
print line #2, "premiere", "deux" + "ieme", "tab" + chr$(9) + "x"
close 2
dim l$(3)
open input 2, "lines.txt"
input line #2, a$, l$(1)
input line #2, b$
print a$; "/"; l$(1); "/"; b$; "/"; eof(2)
close
